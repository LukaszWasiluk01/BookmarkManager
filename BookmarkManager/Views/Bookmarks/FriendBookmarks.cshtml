@using X.PagedList.Mvc.Core
@model X.PagedList.IPagedList<BookmarkManager.Models.Bookmark>

@{
    ViewData["Title"] = "Zakładki znajomego";
}

<h1>Zakładki użytkownika @ViewBag.FriendEmail</h1>

<form asp-action="FriendBookmarks" method="get" class="mb-4 mt-4">
    <input type="hidden" name="id" value="@ViewBag.FriendId" />
    <div class="form-actions no-color row align-items-end">
        <div class="col-md-4">
            <label>Wyszukaj w opisie lub URL:</label>
            <input type="text" name="SearchString" value="@ViewBag.CurrentFilter" class="form-control" />
        </div>
        <div class="col-md-3">
            <label>Kategoria:</label>
            <select name="categoryId" class="form-control" asp-items="ViewBag.Categories">
                <option value="">Wszystkie</option>
            </select>
        </div>
        <div class="col-md-4">
            <input type="submit" value="Filtruj" class="btn btn-outline-dark" />
            <a asp-action="FriendBookmarks" asp-route-id="@ViewBag.FriendId" class="btn btn-outline-secondary">Wyczyść</a>
        </div>
    </div>
</form>

<table class="table table-hover">
    <thead class="table-dark">
        <tr>
            <th>
                <a asp-action="FriendBookmarks" asp-route-id="@ViewBag.FriendId" asp-route-sortOrder="@ViewBag.DateSortParm" asp-route-currentFilter="@ViewBag.CurrentFilter" asp-route-categoryId="@ViewBag.CurrentCategory" class="text-white text-decoration-none">Data utworzenia</a>
            </th>
            <th>
                <a asp-action="FriendBookmarks" asp-route-id="@ViewBag.FriendId" asp-route-sortOrder="@ViewBag.DescSortParm" asp-route-currentFilter="@ViewBag.CurrentFilter" asp-route-categoryId="@ViewBag.CurrentCategory" class="text-white text-decoration-none">Opis zakładki</a>
            </th>
            <th>Adres URL</th>
            <th>Kategoria</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="4" class="text-center">Ten znajomy nie dodał jeszcze żadnych zakładek.</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.CreatedAt)</td>
                    <td>@Html.DisplayFor(modelItem => item.Description)</td>
                    <td>
                        <a href="@item.Url" target="_blank" class="btn btn-sm btn-success">Przejdź do linku</a>
                    </td>
                    <td>
                        <a asp-controller="Categories" asp-action="Details" asp-route-id="@item.CategoryId" class="text-decoration-none fw-bold">
                            @Html.DisplayFor(modelItem => item.Category.Name)
                        </a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<br />
<div class="d-flex justify-content-center">
    @Html.PagedListPager(Model, page => Url.Action("FriendBookmarks", new { id = ViewBag.FriendId, page, sortOrder = ViewBag.CurrentSort, currentFilter = ViewBag.CurrentFilter, categoryId = ViewBag.CurrentCategory }), new PagedListRenderOptions
    {
        LiElementClasses = new string[] { "page-item" },
        PageClasses = new string[] { "page-link" }
    })
</div>

<div>
    <a asp-controller="Friends" asp-action="Index" class="btn btn-secondary">Wróć do listy znajomych</a>
</div>